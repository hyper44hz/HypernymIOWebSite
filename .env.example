# Contact form endpoint used by the frontend (baked in at build time).
# "/api/contact" = the bundled Node server (server.ts). Leave empty to fall back
# to a pre-filled mailto: link instead.
VITE_CONTACT_FORM_ENDPOINT="/api/contact"

# --- Server-side only (never prefix these with VITE_) ---
PORT=3001
MAIL_FROM="support@hypernym.io"
CONTACT_TO="sales@hypernym.io"

# Option A (recommended for Microsoft 365): Microsoft Graph via an Entra app registration.
# If GRAPH_TENANT_ID is set, Graph is used and the SMTP_* vars are ignored.
GRAPH_TENANT_ID=""
GRAPH_CLIENT_ID=""
GRAPH_CLIENT_SECRET=""

# Option B: SMTP AUTH with the mailbox password.
# Microsoft 365: smtp.office365.com, port 587 (STARTTLS). Microsoft is turning
# password-based SMTP AUTH off by default from Dec 2026 — prefer Option A.
SMTP_HOST="smtp.office365.com"
SMTP_PORT=587
SMTP_USER="support@hypernym.io"
SMTP_PASS=""
